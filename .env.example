# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# --- Supabase -----------------------------------------------------------
# From your Supabase project: Settings → Data API (URL + anon key)
# and Settings → API Keys (service_role key).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database (Drizzle) -------------------------------------------------
# Supabase → Settings → Database → Connection string → "Transaction pooler"
# (port 6543). URL-encode the password if it contains special characters.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# --- App ----------------------------------------------------------------
# Canonical site URL. Use http://localhost:3000 in development; set to the
# production domain on Vercel. Drives auth redirects and OG/metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI Bracelet Designer (Phase 2) -------------------------------------
# Which provider generates designs: "gemini" (free tier, default) or "anthropic".
AI_PROVIDER="gemini"
# Google AI Studio key (aistudio.google.com/apikey). Server-only — never exposed.
GEMINI_API_KEY="your-gemini-api-key"
# Only needed if AI_PROVIDER="anthropic". Server-only.
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# Turns the /designer feature on (public flag). Set to 1 to enable.
NEXT_PUBLIC_FEATURE_AI_DESIGNER="1"
